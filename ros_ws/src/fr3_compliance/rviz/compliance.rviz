Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: ForceArrows
      Topic:
        Value: /force_markers
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Status
      Topic:
        Value: /status_marker
      Value: true
  Global Options:
    Fixed Frame: base_link
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.4
      Focal Point: {X: -0.2, Y: 0.0, Z: 0.45}
      Pitch: 0.4
      Yaw: 0.9
